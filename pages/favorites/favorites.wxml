<view class="container">
  <!-- 顶部导航 -->
  <view class="nav-bar" style="height: {{navTotalHeight}}px;">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-content">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-arrow">‹</text>
      </view>
      <text class="nav-title">我的收藏</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}" style="padding-top: {{navTotalHeight + 100}}px;">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 收藏列表 -->
  <view class="fav-list" wx:elif="{{favorites.length > 0}}" style="padding-top: {{navTotalHeight + 20}}px;">
    <view class="fav-item" wx:for="{{favorites}}" wx:key="id" wx:for-index="idx"
          data-id="{{item.product_id}}" bindtap="onFavoriteTap">
      <image class="fav-banner" src="{{item.product_banner}}" mode="aspectFill"></image>
      <view class="fav-info">
        <text class="fav-title">{{item.product_title || '未命名产品'}}</text>
        <text class="fav-date">{{item.create_time}}</text>
      </view>
      <view class="fav-remove" data-id="{{item.product_id}}" data-index="{{idx}}"
            catchtap="onRemoveFavorite">
        <text>取消收藏</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:else style="padding-top: {{navTotalHeight + 100}}px;">
    <text class="empty-text">暂无收藏</text>
  </view>
</view>
