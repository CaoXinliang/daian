.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  width: 48rpx;
  display: flex;
  align-items: center;
}

.nav-back-arrow {
  font-size: 44rpx;
  color: #1a1a1a;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.fav-list {
  padding: 0 0 40rpx;
}

.fav-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 0 24rpx 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.fav-item:active {
  opacity: 0.85;
}

.fav-banner {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.fav-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.fav-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fav-date {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.fav-remove {
  padding: 12rpx 20rpx;
  margin-right: 20rpx;
  font-size: 22rpx;
  color: #e05050;
  white-space: nowrap;
}

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
