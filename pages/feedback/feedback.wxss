.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 20rpx;
}

.feedback-input {
  width: 100%;
  min-height: 300rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background-color: #4AA39C;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 8rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.submit-btn::after {
  border: none;
}
