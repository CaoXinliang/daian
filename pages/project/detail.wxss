.detail-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 40rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.status-card {
  margin: 24rpx;
  padding: 36rpx 28rpx;
  background: linear-gradient(135deg, #4AA39C 0%, #6BC4BC 100%);
  border-radius: 16rpx;
  color: #ffffff;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.status-project {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-order {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.section {
  margin-top: 28rpx;
  padding: 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #4AA39C;
}

.timeline {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.tl-item {
  display: flex;
  position: relative;
  padding-bottom: 28rpx;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ddd;
  margin-top: 6rpx;
  flex-shrink: 0;
  z-index: 1;
}

.tl-dot.done {
  background: #4AA39C;
  box-shadow: 0 0 0 6rpx rgba(74, 163, 156, 0.15);
}

.tl-content {
  flex: 1;
  margin-left: 20rpx;
}

.tl-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.tl-time {
  font-size: 22rpx;
  color: #bbb;
}

.tl-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.tl-line {
  position: absolute;
  left: 9rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #eee;
}

.designer-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.designer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.designer-info {
  flex: 1;
  margin-left: 20rpx;
}

.designer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.designer-role {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.designer-btn {
  padding: 12rpx 28rpx;
  background: #e8f6f4;
  color: #4AA39C;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 32rpx;
}

.desc-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

.material-grid, .deliver-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #ffffff;
  padding: 20rpx;
  border-radius: 16rpx;
}

.material-img, .deliver-img {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.bottom-space {
  height: 40rpx;
}
