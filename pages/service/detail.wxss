.detail-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 160rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.error-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
}

.top-hero {
  padding: 80rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #0c4a6e 0%, #0e7490 40%, #4AA39C 100%);
  color: #ffffff;
  text-align: center;
}

.top-hero-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.top-hero-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.top-hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.info-card {
  margin: -30rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}

.info-row {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.info-value.price {
  color: #ff6b35;
}

.info-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

.section {
  margin-top: 36rpx;
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.feature-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-check {
  color: #4AA39C;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.process-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.process-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.process-item:last-child {
  padding-bottom: 0;
}

.process-step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4AA39C 0%, #6BC4BC 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.process-info {
  flex: 1;
  margin-left: 20rpx;
  padding-top: 4rpx;
}

.process-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.process-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.process-line {
  position: absolute;
  left: 23rpx;
  top: 56rpx;
  bottom: 0;
  width: 2rpx;
  background: #e8e8e8;
}

.bottom-space {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #0c4a6e 0%, #0e7490 40%, #4AA39C 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn::after {
  border: none;
}
