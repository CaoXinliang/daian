<view class="container">
  <view class="info-list">
    <view class="info-item" bindtap="onNicknameTap">
      <view class="info-label">昵称</view>
      <view class="info-value-wrap">
        <view class="info-value">{{userInfo.nickname}}</view>
        <view class="info-arrow">></view>
      </view>
    </view>
    <view class="info-item">
      <view class="info-label">手机号</view>
      <view class="info-value">{{userInfo.phone}}</view>
    </view>
  </view>

  <view class="btn-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
    <view class="delete-btn" bindtap="onDeleteAccount">注销账号</view>
  </view>
</view>
