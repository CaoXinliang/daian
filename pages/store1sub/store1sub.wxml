<!-- 自定义导航栏 -->
<view class="custom-nav" style="height: {{navTotalHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-title-bar">
    <view class="nav-back-btn" bindtap="goBack">
      <text class="nav-back-arrow">‹</text>
    </view>
    <text class="nav-title">{{categoryName}}</text>
  </view>
</view>

<!-- 产品列表页 -->
<view class="container" style="padding-top: {{navTotalHeight}}px;">
  <view class="product-list">
    <view
      class="product-item"
      wx:for="{{products}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <view class="product-thumb-wrap">
        <image
          wx:if="{{item.thumbnail}}"
          class="product-thumb"
          src="{{item.thumbnail}}"
          mode="aspectFill"
          lazy-load
        ></image>
        <view wx:else class="product-thumb-placeholder">
          <text class="thumb-placeholder-text">暂无图片</text>
        </view>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
      </view>
      <view class="product-arrow">
        <text class="arrow-icon">›</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{products.length === 0}}">
    <text class="empty-text">该分类暂无产品</text>
  </view>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="bottom-btn" bindtap="onFavorite">
    <text class="bottom-btn-icon {{isFavorited ? 'active' : ''}}">{{isFavorited ? '★' : '☆'}}</text>
    <text class="bottom-btn-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
  </view>
  <button class="bottom-btn share-btn" open-type="share">
    <text class="bottom-btn-icon">↗</text>
    <text class="bottom-btn-text">分享</text>
  </button>
  <view class="bottom-btn" bindtap="onMore">
    <text class="bottom-btn-icon">☰</text>
    <text class="bottom-btn-text">更多</text>
  </view>
</view>
