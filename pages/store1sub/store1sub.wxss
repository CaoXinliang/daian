/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  z-index: 999;
  border-bottom: 1rpx solid #eeeeee;
}

.nav-title-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-arrow {
  font-size: 44rpx;
  color: #333333;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

/* 页面容器 */
.container {
  background-color: #ffffff;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

/* 产品列表 */
.product-list {
  padding: 0 30rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:active {
  background-color: #f9f9f9;
}

.product-thumb-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.product-thumb {
  width: 100%;
  height: 100%;
}

.product-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5ebe0;
}

.thumb-placeholder-text {
  font-size: 20rpx;
  color: #999999;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
  line-height: 1.4;
}

.product-arrow {
  flex-shrink: 0;
  padding-left: 16rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: #cccccc;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #cccccc;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid #eeeeee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.bottom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.bottom-btn::after {
  border: none;
}

.bottom-btn-icon {
  font-size: 36rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.bottom-btn-icon.active {
  color: #f5a623;
}

.bottom-btn-text {
  font-size: 22rpx;
  color: #666666;
}

.share-btn {
  background: transparent;
}

.share-btn .bottom-btn-text {
  color: #666666;
}
