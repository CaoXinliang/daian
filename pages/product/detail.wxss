/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: background 0.3s ease;
}

.nav-transparent { background: transparent; }
.nav-solid {
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

.nav-back-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-solid .nav-back-circle { background: transparent; }

.nav-back-arrow {
  font-size: 44rpx;
  color: #333;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 容器 */
.container {
  min-height: 100vh;
  background: #ffffff;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 错误 */
.error-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.error-text {
  font-size: 30rpx;
  color: #999;
}

/* 商品名称在页面顶部 - 居中 */
.page-name-wrap {
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 0;
  text-align: center;
}

.good-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 32rpx;
}

/* 商品图片 - 无间距 */
.good-images {
  width: 100%;
}

.good-img {
  width: 100%;
  display: block;
}

/* 底部操作栏 - 不固定，放在页面底部 */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  background: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #f0f0f0;
}

.bottom-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  line-height: 1.5;
}

.bottom-btn::after { border: none; }

.bottom-btn-icon {
  font-size: 36rpx;
  color: #666;
}

.bottom-btn-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.bottom-btn-share {
  padding: 0;
  margin: 0;
}

.bottom-btn-share::after { border: none; }
