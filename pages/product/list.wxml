<!-- 顶部导航栏（滚动时显示标题） -->
<view class="custom-nav {{navBarVisible ? 'nav-solid' : 'nav-transparent'}}" style="height: {{navTotalHeight}}px;">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-content">
    <view class="nav-back" bindtap="goBack">
      <view class="nav-back-circle">
        <text class="nav-back-arrow">‹</text>
      </view>
    </view>
    <text class="nav-title" wx:if="{{navBarVisible}}">{{categoryName}}</text>
  </view>
</view>

<!-- 页面主体 -->
<view class="container">

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view class="error-wrap" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 商品列表 -->
  <block wx:else>
    <!-- 分类名称在页面顶部 -->
    <view class="page-name-wrap" style="padding-top: {{navTotalHeight + 10}}px;">
      <text class="page-name category-name">{{categoryName}}</text>
    </view>

    <view class="goods-list" wx:if="{{goods.length > 0}}">
      <view class="goods-item" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoodTap">
        <view class="goods-thumb-wrap">
          <image class="goods-thumb" src="{{item.cover_url}}" mode="aspectFill"></image>
        </view>
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-model" wx:if="{{item.model}}">{{item.model}}</text>
        </view>
        <text class="goods-arrow">›</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:else>
      <text class="empty-text">暂无商品</text>
    </view>
  </block>
</view>
