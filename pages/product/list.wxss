/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: background 0.3s ease;
}

.nav-transparent { background: transparent; }
.nav-solid {
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

.nav-back-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-solid .nav-back-circle { background: transparent; }

.nav-back-arrow {
  font-size: 44rpx;
  color: #333;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 容器 */
.container {
  min-height: 100vh;
  background: #ffffff;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 错误 */
.error-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.error-text {
  font-size: 30rpx;
  color: #999;
}

/* 分类名称在页面顶部 - 居中 */
.page-name-wrap {
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 20rpx;
  text-align: center;
}

.category-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

/* 商品列表 */
.goods-list {
  background: #ffffff;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 48rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-item:active { background: #f9f9f9; }

.goods-thumb-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods-thumb {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
}

.goods-model {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.goods-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
