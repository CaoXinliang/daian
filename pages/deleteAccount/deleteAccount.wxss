.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.warning-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background-color: #fff2f0;
  color: #ff4d4f;
  font-size: 60rpx;
  font-weight: bold;
  margin: 0 auto 40rpx;
}

.warning-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.warning-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 60rpx;
}

.account-info {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-label {
  font-size: 28rpx;
  color: #999999;
}

.account-phone {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 80rpx;
}

.btn-group {
  display: flex;
  gap: 30rpx;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  background-color: #f5f5f5;
  color: #666666;
  font-size: 30rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-btn::after {
  border: none;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  background-color: #ff4d4f;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.confirm-btn::after {
  border: none;
}
