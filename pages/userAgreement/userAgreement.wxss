.container {
  min-height: 100vh;
  background-color: #ffffff;
}

.content {
  padding: 40rpx 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 20rpx;
}

.update-date {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 50rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.section-text.sub {
  padding-left: 40rpx;
}
