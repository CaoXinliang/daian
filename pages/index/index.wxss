.index-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 固定导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 88rpx;
  padding-top: calc(env(safe-area-inset-top) + 45px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s;
}

.nav-transparent {
  background: transparent;
}

.nav-solid {
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-logo {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-back-btn {
  position: absolute;
  left: 24rpx;
  top: calc(env(safe-area-inset-top) + 20px);
  bottom: 0;
  width: 64rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #1a1a1a;
  line-height: 1;
}

/* 顶部品牌区 - 延伸到手机顶部 */
.hero-section {
  margin: 0;
  padding: 0 36rpx 56rpx;
  background: linear-gradient(135deg, #0c4a6e 0%, #0e7490 40%, #4AA39C 100%);
  color: #ffffff;
  text-align: center;
}

.hero-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.hero-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.hero-brand-name {
  font-size: 24rpx;
}

.hero-slogan {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.5;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4AA39C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 区块 */
.section {
  margin-top: 44rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-sub {
  font-size: 24rpx;
  color: #999;
}

/* 服务卡片 */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.service-card {
  width: calc((100% - 20rpx) / 2);
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.service-card:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.service-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon-blue { background: linear-gradient(135deg, #e3f0ff 0%, #c8ddff 100%); }
.icon-orange { background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); }
.icon-purple { background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%); }
.icon-green { background: linear-gradient(135deg, #e8f6f4 0%, #d4eeeb 100%); }

.service-icon {
  font-size: 40rpx;
}

.service-card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.service-card-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.service-card-price {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ff6b35;
}

/* 精选案例 */
.cases-scroll {
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.case-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.case-card:active {
  opacity: 0.85;
}

.case-cover {
  width: 280rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.case-emoji {
  font-size: 48rpx;
}

.case-title {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 公司介绍 */
.intro-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
}

.intro-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.intro-label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.intro-value {
  font-size: 26rpx;
  color: #1a1a1a;
  flex: 1;
}

.intro-divider {
  height: 1rpx;
  background: #f5f5f5;
}

/* 底部空间 */
.bottom-space {
  height: 40rpx;
}

/* 底部悬浮按钮 - 靠近底部导航 */
.submit-float {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 10rpx);
  height: 88rpx;
  background: linear-gradient(135deg, #0c4a6e 0%, #0e7490 40%, #4AA39C 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(74, 163, 156, 0.4);
  z-index: 99;
}

.submit-float:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.submit-float-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}
